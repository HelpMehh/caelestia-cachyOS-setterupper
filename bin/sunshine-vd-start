#!/usr/bin/env bash
# caelestia-setup: Sunshine runs this before every stream (sunshine.conf:
# global_prep_cmd). It swaps the real monitors for a virtual display sized
# to the device that is connecting.
#
# The layout is written to a state file as well as applied. Any Hyprland
# config reload (a wallpaper change causes one) wipes monitor rules set at
# run time, so hypr/base.lua re-applies this file on every reload.
# sunshine-vd-stop deletes it.
#
# It also blocks sleep for as long as the stream runs, so the idle timer
# can't suspend the PC mid-stream (input through a stream counts as
# activity, but watching a video or a paused game doesn't).

WIDTH=$SUNSHINE_CLIENT_WIDTH
HEIGHT=$SUNSHINE_CLIENT_HEIGHT
FPS=${SUNSHINE_CLIENT_FPS:-60}

# These come from the streaming device and end up in Lua that Hyprland runs,
# so accept plain numbers only.
for v in "$WIDTH" "$HEIGHT" "$FPS"; do
    case "$v" in
        ''|*[!0-9]*) echo "sunshine-vd-start: bad client mode '${WIDTH}x${HEIGHT}@${FPS}'" >&2; exit 1 ;;
    esac
done

run="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
STATE="$run/sunshine_vd.lua"
OUTPUTS="$run/sunshine_vd.outputs"
INHIBIT="$run/sunshine_vd.inhibit"

# Every monitor that is on right now (whatever this machine has), except
# virtual ones. Names are checked before they go into Lua.
hyprctl monitors -j | python3 -c '
import json, re, sys
for m in json.load(sys.stdin):
    name = m.get("name", "")
    if name == "sunshine_vd" or name.startswith("HEADLESS"):
        continue
    if re.fullmatch(r"[A-Za-z0-9_-]+", name):
        print(name)' > "$OUTPUTS.tmp" || exit 1
mv "$OUTPUTS.tmp" "$OUTPUTS"

{
    printf 'hl.monitor({ output = "sunshine_vd", mode = "%sx%s@%s", position = "auto", scale = 1 })\n' \
        "$WIDTH" "$HEIGHT" "$FPS"
    while read -r name; do
        printf 'hl.monitor({ output = "%s", disabled = true })\n' "$name"
    done < "$OUTPUTS"
} > "$STATE"

hyprctl output create headless sunshine_vd
hyprctl eval "dofile('$STATE')" || exit

# End a block left over from a stream whose stop script never ran. The name
# check makes sure a reused PID can't kill some other process.
if [ -f "$INHIBIT" ]; then
    read -r pid < "$INHIBIT"
    case "$pid" in
        ''|*[!0-9]*) ;;
        *) if [ "$(cat "/proc/$pid/comm" 2>/dev/null)" = systemd-inhibit ]; then
               pkill -P "$pid"
               kill "$pid"
           fi ;;
    esac
    rm -f "$INHIBIT"
fi

# Plain & keeps the block inside Sunshine's own cgroup, so it also ends if
# Sunshine crashes or is restarted. Its output goes nowhere, so it can't keep
# Sunshine waiting for this script to finish.
systemd-inhibit --what=sleep --mode=block --who=Sunshine --why="Streaming" \
    sleep infinity </dev/null >/dev/null 2>&1 &
echo $! > "$INHIBIT"

# logind can refuse the block (polkit). The stream should still go ahead, so
# only note it in Sunshine's log.
sleep 0.2
kill -0 "$(cat "$INHIBIT")" 2>/dev/null ||
    echo "sunshine-vd-start: could not block sleep; the PC may suspend during the stream" >&2
exit 0
